NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Pakasir API v2 (server-side only; never expose the API key to NEXT_PUBLIC_ variables)
PAKASIR_PROJECT_SLUG=
PAKASIR_API_KEY=
# Hosted checkout lets customers select payment methods enabled in your Pakasir project.
PAKASIR_PAYMENT_METHOD=payment_link

# NEXORA Admin Agent — OpenAI-compatible 9router endpoint
NEXORA_9ROUTER_URL=http://127.0.0.1:20128/v1
NEXORA_9ROUTER_API_KEY=
NEXORA_AGENT_MODEL=gratisan
