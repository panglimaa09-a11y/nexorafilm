NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Pakasir v2 hosted checkout (server-only credentials)
PAKASIR_PROJECT_SLUG=
PAKASIR_API_KEY=
PAKASIR_PAYMENT_METHOD=payment_link

NEXT_PUBLIC_APP_URL=http://localhost:3000

# NEXORA Admin Agent — OpenAI-compatible 9router endpoint
NEXORA_9ROUTER_URL=http://127.0.0.1:20128/v1
NEXORA_9ROUTER_API_KEY=
NEXORA_AGENT_MODEL=gratisan

# Gemini video moderation (server-only; key must never be exposed to the browser)
GEMINI_API_KEY=

# Optional fallback: a separately hosted moderation service
VIDEO_MODERATION_API_URL=
VIDEO_MODERATION_API_KEY=
